# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-secret-key

# Database (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Weather (OpenWeatherMap example)
WEATHER_API_KEY=your-openweathermap-api-key
WEATHER_API_BASE_URL=

# CORS
CORS_ORIGINS=http://localhost:3000

# Gemini API
GEMINI_API_KEY=
# Text model (defaults to gemini-flash-latest if unset)
GEMINI_MODEL=
# Image-generation model used for crop lifecycle photos - must be an
# image-capable model (defaults to gemini-2.5-flash-image if unset). Image
# generation requires a Gemini API key with billing enabled; free-tier keys
# have a 0 request/day quota for image models.
GEMINI_IMAGE_MODEL=

# Admin User Initialization (for seed_admin.py)
ADMIN_EMAIL=admin@valam.lk
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_NAME=Valam Administrator
ADMIN_PHONE=+94770000000