# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-secret-key

# Database (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/solar_farming_db

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# AI Chatbot (plug in your provider - Anthropic / OpenAI / etc.)
AI_PROVIDER_API_KEY=your-ai-provider-api-key
AI_PROVIDER_URL=https://api.anthropic.com/v1/messages

# Weather (OpenWeatherMap example)
WEATHER_API_KEY=your-openweathermap-api-key
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# CORS
CORS_ORIGINS=http://localhost:3000
